prefix=/home/runner/work/omniglot-lfi/omniglot-lfi/examples/brotli/og_brotli_lfi/build/brotli_lfi/install
exec_prefix=/home/runner/work/omniglot-lfi/omniglot-lfi/examples/brotli/og_brotli_lfi/build/brotli_lfi/install
libdir=${prefix}/lib
includedir=${prefix}/include

